<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MOROPO.CPCC.CinemaStreet.Arsmart.UI.Pages.HelpPage"
    Title="Ayuda de la Aplicación"
    BackgroundColor="White">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="Black" />
                <Setter Property="FontSize" Value="18" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <ScrollView Orientation="Vertical">
            <StackLayout Spacing="0">
                <StackLayout Padding="16" Spacing="16">
                    <Label Text="Para comenzar a utilizar nuestra aplicación luego de instalarla, primeramente otorgue los permisos de uso de la cámara a la misma." />
                    <Image x:Name="PermisionImage"/>
                    <Label Text="Apunte la cámara de su celular hacia el Mural. Verá en su pantalla como se activa una pantalla interactiva enmarcando los carteles del Mural." />
                    <Image x:Name="MuralImage"/>
                    <Label Text="Seguidamente selecione en la pantalla el cartel de su preferencia." />
                    <Image x:Name="CartelImage"/>
                    <Label Text="Luego de selecionada le saldrá una nueva ventana con el Cartel escogido, y toda la información relacionada con el mismo, desde su autor hasta lo que representa (ya sea una película, documental o información sobre el cine en general)."/>
                    <Image x:Name="InformationImage"/>
                    <Label Text="En el botón de Detalles que esta debajo del autor del Cartel, podrá acceder a información sobre la vida del Autor."/>
                    <Image x:Name="DetailsImage"/>
                    <Image x:Name="DetailsAutorImage"/>
                    <Label Text="Además nuestra aplicación cuenta con 2 secciones más: la Sección de Acerca de y la Sección de Ayuda, en la que usted se encuentra en estos momentos."/>

                </StackLayout>
            </StackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>